# ZeroWaste Meals frontend environment
# Copy to .env or .env.local and adjust per environment.

# REST API base URL (existing variable, unchanged).
# Local development backend URL:
VITE_API_URL=http://localhost:8080/api
# Production (Render) backend URL:
# VITE_API_URL=https://foodredistribution.onrender.com/api

# STOMP/SockJS endpoint for real-time notifications.
# Optional: if omitted, it is derived from VITE_API_URL by stripping the trailing "/api".
# Local development:
VITE_WS_BASE_URL=http://localhost:8080/ws
# Production (Render):
# VITE_WS_BASE_URL=https://foodredistribution.onrender.com/ws
