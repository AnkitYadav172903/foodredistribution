# ZeroWaste Meals backend - local environment template
#
# Copy to .env and fill in real values:
#   cp .env.example .env
#
# .env is git-ignored. Never commit real credentials.
# Spring Boot loads this file via the line
#   spring.config.import=optional:file:.env[.properties]
# in src/main/resources/application.properties, so no extra tooling is needed.
#
# In production (Render) set these as Environment Variables instead - nothing else changes.

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=jdbc:postgresql://<host>/<db>?sslmode=require
DATABASE_USER=<database-user>
DATABASE_PASSWORD=<database-password>
DB_NAME=<database-name>

# --- JWT ---
# REQUIRED. The app refuses to start if this is missing, so there is no fallback secret.
# Must be at least 32 characters. Generate one with:  openssl rand -hex 32
# Rotating this value invalidates every issued token, so all users must log in again.
JWT_SECRET=replace-with-a-strong-random-secret

# --- Optional (sensible defaults exist for all of these) ---
# JPA_DDL_AUTO=update
# SHOW_SQL=false
# UPLOAD_DIR=uploads
# JWT_EXPIRATION=86400000
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# WEBSOCKET_ALLOWED_ORIGINS=*
# PORT=8080